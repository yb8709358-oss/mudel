# App
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Mudel

# Canonical public origin (used for BFF origin checks / CSRF defense).
# Set this to the real production URL, e.g. https://mudel.ma
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# API
# Local development (backend must be started with --host 0.0.0.0):
NEXT_PUBLIC_API_URL=http://localhost:8000
# LAN development — point the browser bundle at the machine's LAN IP so the
# page works when opened as http://<LAN_IP>:3001:
# NEXT_PUBLIC_API_URL=http://192.168.0.194:8000

# Server-only backend origin used by the Next.js server for SSR / route handler
# fetches. REQUIRED inside the Docker stack, where localhost:8000 is unreachable
# from the frontend container — docker-compose.yml sets it to
# http://backend:8000 automatically. For `npm run dev` on the host it can stay
# unset (falls back to NEXT_PUBLIC_API_URL).
# INTERNAL_API_URL=http://localhost:8000

# Admin panel (server-only — never exposed to the browser)
# Real credentials are intentionally NOT shipped in this example. Create
# frontend/.env.local with values generated locally, e.g.:
#   openssl rand -hex 24
# ADMIN_PASSWORD — the password the operator types on the admin login screen.
# ADMIN_API_SECRET — must match the backend's ADMIN_API_SECRET (backend/.env).
# Admin login FAILS CLOSED when these are missing or placeholders.

# Public contact information (phone, email, WhatsApp, address, hours, socials)
# is configured in the Admin Settings panel and served from the backend
# settings store — it is not read from environment variables.
