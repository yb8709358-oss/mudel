# ============================================
# Mudel Backend
# ============================================

APP_NAME=Mudel
APP_VERSION=1.0.0

ENVIRONMENT=development
DEBUG=True

DATABASE_URL=postgresql://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@db.CHANGE_ME_PROJECT_REF.supabase.co:5432/mudel

# Comma-separated (JSON array) of origins allowed to call this API from a browser.
# Standard local development origins are listed below. For LAN development, append
# your machine's LAN origin, e.g. "http://192.168.0.194:3001".
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

CONTACT_EMAIL_TO=hello@mudel.ma

ADMIN_API_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# Supabase Storage (request image uploads). Set SUPABASE_SERVICE_ROLE_KEY
# from the Supabase dashboard (Settings → API). The project URL is derived
# from DATABASE_URL automatically. Leave empty to disable image uploads.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=request-images

# Days a "complete your request" link stays valid after the contact form is sent.
REQUEST_TOKEN_TTL_DAYS=7
