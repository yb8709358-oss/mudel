# ============================================
# Mudel Backend
# ============================================

APP_NAME=Mudel
APP_VERSION=1.0.0

ENVIRONMENT=development
DEBUG=True

# Database — two ways to configure:
# 1) Direct connection string (bare-metal dev / docker-compose.prod.yml):
#    postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# 2) DB_* components (docker-compose.yml passes these; they build DATABASE_URL
#    with proper URL-encoding). Leave empty when using DATABASE_URL directly.
DATABASE_URL=postgresql://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@db.CHANGE_ME_PROJECT_REF.supabase.co:5432/mudel
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=mudel

# Redis (rate limiting storage).
# Optional in development (falls back to in-memory), REQUIRED in production.
# Local bare-metal: redis://localhost:6379/0
# Docker Compose:   redis://redis:6379/0  (service name)
REDIS_URL=redis://localhost:6379/0

# Comma-separated (JSON array) of origins allowed to call this API from a browser.
# Standard local development origins are listed below. For LAN development, append
# your machine's LAN origin, e.g. "http://192.168.0.194:3001".
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

CONTACT_EMAIL_TO=hello@mudel.ma

ADMIN_API_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# Supabase Storage (request image uploads). Set SUPABASE_SERVICE_ROLE_KEY
# from the Supabase dashboard (Settings → API). The project URL is derived
# from DATABASE_URL automatically. Leave empty to disable image uploads.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=request-images

# Days a "complete your request" link stays valid after the contact form is sent.
REQUEST_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------------------------
# WhatsApp Cloud API integration
# ---------------------------------------------------------------------------
# Set WHATSAPP_ENABLED=true and fill in credentials to activate.
# In production, missing credentials will cause a startup error when enabled.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0
# Admin phone number that receives new-service-request notifications (E.164).
WHATSAPP_ADMIN_PHONE=
