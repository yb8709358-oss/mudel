# =============================================================================
# Mudel — Environment template (copy to `.env` and fill in real values)
# =============================================================================
# NEVER commit the real `.env`. Keep secrets out of the repository.
#
# Two deployment modes are supported — keep their environment files separate:
#
#   LOCAL  (docker-compose.yml) — uses `.env`:
#       Postgres + Redis + backend + frontend on one machine. DATABASE_URL must
#       stay EMPTY; the backend builds the connection URL from
#       DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME with proper URL-encoding
#       (POSTGRES_PASSWORD may contain special chars).
#
#   PRODUCTION  (docker-compose.prod.yml — Oracle Cloud) — uses `.env.prod`:
#       Supabase PostgreSQL is the ONLY production database. Redis + backend +
#       frontend run as containers. The backend uses DATABASE_URL directly and
#       DB_HOST/DB_USER MUST stay empty (they would override DATABASE_URL).
#       Run with:  docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# The backend refuses to start in development mode against a Supabase
# DATABASE_URL (backend/app/core/config.py), so the local stack can never
# accidentally use the production database.
# =============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME=Home Services Marrakech
APP_VERSION=0.1.0

# development | production
ENVIRONMENT=development
DEBUG=True

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# LOCAL ONLY — shared with the `postgres` compose service and used to build the
# backend connection URL. Not used in production.
POSTGRES_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432
DB_USER=mudel
DB_PASSWORD=change-me
DB_NAME=mudel

# PRODUCTION ONLY — Supabase connection string (pgBouncer transaction pooler,
# port 6543). Leave DB_HOST/DB_USER/DB_PASSWORD/DB_NAME empty in production so
# DATABASE_URL is used as-is.
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---------------------------------------------------------------------------
# Redis
# Local compose: redis://redis:6379/0 (service name)
# Production:  redis://redis:6379/0 (container service) or a managed Redis URL
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Admin API — shared secret the Next.js server sends to unlock admin endpoints.
# Must match the backend. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
ADMIN_API_SECRET=change-me-in-production

# ---------------------------------------------------------------------------
# Contact form
# ---------------------------------------------------------------------------
CONTACT_EMAIL_TO=hello@mudel.ma

# ---------------------------------------------------------------------------
# CORS — JSON array of allowed browser origins (no wildcard in production).
# Local: keep the localhost/dev origins. Production: the public site origin,
# e.g. ["https://mudel.ma"].
# ---------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3001"]

# ---------------------------------------------------------------------------
# Supabase Storage — for request image uploads (server-side only).
# The project URL is derived from DATABASE_URL; only the service-role key is
# required. NEVER prefix these with NEXT_PUBLIC_ (they must not reach the
# browser). Leave empty to disable image uploads.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=request-images

# =============================================================================
# Frontend (Next.js)
# =============================================================================
# NEXT_PUBLIC_* variables are embedded in the browser bundle at build time, so
# in production they must point at the public (TLS-terminated) URLs.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://mudel.ma
NEXT_PUBLIC_APP_NAME=Mudel
NEXT_PUBLIC_SITE_URL=https://mudel.ma
# Backend API reached by the browser (public client forms) and the Next.js
# server. Local dev: http://localhost:8000 (backend started with --host 0.0.0.0).
NEXT_PUBLIC_API_URL=https://api.mudel.ma

# Admin login password (server-only — read by the Next.js server, never the
# browser). Fail-closed when missing or a placeholder.
ADMIN_PASSWORD=change-me
